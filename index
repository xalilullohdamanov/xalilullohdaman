        function selectDoctor(docName, dept) {
            const deptSelect = document.getElementById('department-select');
            deptSelect.value = dept;
            const appSection = document.getElementById('appointment');
            appSection.scrollIntoView({ behavior: 'smooth' });
        }

        // ==========================================
        // THREE.JS 3D HERO HELIX & SCENE INITIALIZATION
        // ==========================================
        let heroScene, heroCamera, heroRenderer, dnaGroup, particlesMesh;

        function initHero3D() {
            const container = document.getElementById('hero-3d-container');
            const width = container.clientWidth;
            const height = container.clientHeight;

            heroScene = new THREE.Scene();

            heroCamera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
            heroCamera.position.set(0, 0, 18);

            heroRenderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            heroRenderer.setSize(width, height);
            heroRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            container.appendChild(heroRenderer.domElement);

            // Lights
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
            heroScene.add(ambientLight);

            const pointLight1 = new THREE.PointLight(0x0ea5e9, 2, 50);
            pointLight1.position.set(10, 10, 10);
            heroScene.add(pointLight1);

            const pointLight2 = new THREE.PointLight(0x818cf8, 2, 50);
            pointLight2.position.set(-10, -10, -10);
            heroScene.add(pointLight2);

            // DNA Helix Geometry Construction
            dnaGroup = new THREE.Group();

            const sphereGeo = new THREE.SphereGeometry(0.22, 16, 16);
            const matCyan = new THREE.MeshPhongMaterial({ color: 0x38bdf8, emissive: 0x0284c7, shininess: 80 });
            const matIndigo = new THREE.MeshPhongMaterial({ color: 0x818cf8, emissive: 0x4338ca, shininess: 80 });
            const matCylinder = new THREE.MeshPhongMaterial({ color: 0x334155, transparent: true, opacity: 0.8 });

            const count = 30;
            const radius = 2.5;
            const heightStep = 0.35;

            for (let i = 0; i < count; i++) {
                const angle = i * 0.3;
                const y = (i - count / 2) * heightStep;

                // Strand 1
                const x1 = Math.cos(angle) * radius;
                const z1 = Math.sin(angle) * radius;
                const sphere1 = new THREE.Mesh(sphereGeo, matCyan);
                sphere1.position.set(x1, y, z1);
                dnaGroup.add(sphere1);

                // Strand 2
                const x2 = Math.cos(angle + Math.PI) * radius;
                const z2 = Math.sin(angle + Math.PI) * radius;
                const sphere2 = new THREE.Mesh(sphereGeo, matIndigo);
                sphere2.position.set(x2, y, z2);
                dnaGroup.add(sphere2);

                // Connecting Bar
                const distance = new THREE.Vector3(x1, y, z1).distanceTo(new THREE.Vector3(x2, y, z2));
                const cylinderGeo = new THREE.CylinderGeometry(0.04, 0.04, distance, 8);
                const bar = new THREE.Mesh(cylinderGeo, matCylinder);

                bar.position.set((x1 + x2) / 2, y, (z1 + z2) / 2);
                bar.lookAt(new THREE.Vector3(x1, y, z1));
                bar.rotateX(Math.PI / 2);
                dnaGroup.add(bar);
            }

            heroScene.add(dnaGroup);

            // Floating Background Particles
            const particlesGeo = new THREE.BufferGeometry();
            const pCount = 200;
            const posArray = new Float32Array(pCount * 3);

            for(let i=0; i < pCount * 3; i++) {
                posArray[i] = (Math.random() - 0.5) * 30;
            }

            particlesGeo.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
            const pMat = new THREE.PointsMaterial({
                size: 0.08,
                color: 0x38bdf8,
                transparent: true,
                opacity: 0.6
            });

            particlesMesh = new THREE.Points(particlesGeo, pMat);
            heroScene.add(particlesMesh);

            // Interactive Drag Controls for Hero Canvas
            let isDragging = false;
            let previousMousePosition = { x: 0, y: 0 };

            container.addEventListener('mousedown', (e) => {
                isDragging = true;
            });

            container.addEventListener('mousemove', (e) => {
                if (isDragging) {
                    const deltaMove = {
                        x: e.clientX - previousMousePosition.x,
                        y: e.clientY - previousMousePosition.y
                    };

                    dnaGroup.rotation.y += deltaMove.x * 0.008;
                    dnaGroup.rotation.x += deltaMove.y * 0.008;
                }
                previousMousePosition = { x: e.clientX, y: e.clientY };
            });

            window.addEventListener('mouseup', () => {
                isDragging = false;
            });

            // Touch support for mobile
            container.addEventListener('touchmove', (e) => {
                if (e.touches.length === 1) {
                    const touch = e.touches[0];
                    if (previousMousePosition.x) {
                        const deltaX = touch.clientX - previousMousePosition.x;
                        dnaGroup.rotation.y += deltaX * 0.008;
                    }
                    previousMousePosition = { x: touch.clientX, y: touch.clientY };
                }
            }, { passive: true });
        }

        // ==========================================
        // INTERACTIVE 3D VISUALIZER MODULE
        // ==========================================
        let visScene, visCamera, visRenderer, currentVisMesh;

        function initVisualizer3D() {
            const container = document.getElementById('interactive-visualizer-canvas');
            const width = container.clientWidth;
            const height = container.clientHeight;

            visScene = new THREE.Scene();

            visCamera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
            visCamera.position.set(0, 0, 8);

            visRenderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            visRenderer.setSize(width, height);
            visRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            container.appendChild(visRenderer.domElement);

            const ambientLight = new THREE.AmbientLight(0xffffff, 0.8);
            visScene.add(ambientLight);

            const pointLight = new THREE.PointLight(0x38bdf8, 2, 50);
            pointLight.position.set(5, 5, 5);
            visScene.add(pointLight);

            // Default Mode: DNA Model
            loadVisModel('dna');
        }

        function loadVisModel(type) {
            if (currentVisMesh) visScene.remove(currentVisMesh);

            currentVisMesh = new THREE.Group();

            if (type === 'dna') {
                const geo = new THREE.TorusKnotGeometry(1.5, 0.3, 100, 16);
                const mat = new THREE.MeshStandardMaterial({ color: 0x0ea5e9, wireframe: true });
                const mesh = new THREE.Mesh(geo, mat);
                currentVisMesh.add(mesh);
            } else if (type === 'heart') {
                // Abstract Heart 3D shape simulation
                const heartShape = new THREE.Shape();
                heartShape.moveTo(25, 25);
                heartShape.bezierCurveTo(25, 25, 20, 0, 0, 0);
                heartShape.bezierCurveTo(-30, 0, -30, 35, -30, 35);
                heartShape.bezierCurveTo(-30, 55, -10, 77, 25, 95);
                heartShape.bezierCurveTo(60, 77, 80, 55, 80, 35);
                heartShape.bezierCurveTo(80, 35, 80, 0, 50, 0);
                heartShape.bezierCurveTo(35, 0, 25, 25, 25, 25);

                const extrudeSettings = { depth: 15, bevelEnabled: true, bevelSegments: 3, steps: 2, bevelSize: 3, bevelThickness: 3 };
                const geo = new THREE.ExtrudeGeometry(heartShape, extrudeSettings);
                geo.center();
                geo.scale(0.025, 0.025, 0.025);

                const mat = new THREE.MeshStandardMaterial({ color: 0xf43f5e, roughness: 0.3, metalness: 0.2 });
                const mesh = new THREE.Mesh(geo, mat);
                mesh.rotation.x = Math.PI;
                currentVisMesh.add(mesh);
            } else if (type === 'atoms') {
                // Molecule / Atom Model
                const coreGeo = new THREE.IcosahedronGeometry(1, 2);
                const coreMat = new THREE.MeshPhongMaterial({ color: 0x10b981, wireframe: true });
                const core = new THREE.Mesh(coreGeo, coreMat);
                currentVisMesh.add(core);

                const ringGeo = new THREE.TorusGeometry(2.2, 0.04, 16, 100);
                const ringMat = new THREE.MeshBasicMaterial({ color: 0x34d399 });
                
                const ring1 = new THREE.Mesh(ringGeo, ringMat);
                const ring2 = new THREE.Mesh(ringGeo, ringMat);
                ring2.rotation.x = Math.PI / 3;
                
                currentVisMesh.add(ring1);
                currentVisMesh.add(ring2);
            }

            visScene.add(currentVisMesh);
        }

        function changeVisualizerMode(mode) {
            loadVisModel(mode);
            const statusText = document.getElementById('visualizer-status');
            const btnDna = document.getElementById('btn-dna');
            const btnHeart = document.getElementById('btn-heart');
            const btnAtoms = document.getElementById('btn-atoms');

            // Reset styles
            [btnDna, btnHeart, btnAtoms].forEach(btn => btn.classList.replace('border-sky-500/50', 'border-slate-800'));

            if (mode === 'dna') {
                statusText.innerText = "DNK va Genetik Tahlillar";
                btnDna.classList.replace('border-slate-800', 'border-sky-500/50');
            } else if (mode === 'heart') {
                statusText.innerText = "Yurak va Kardiologiya Vizualizatsiyasi";
                btnHeart.classList.replace('border-slate-800', 'border-sky-500/50');
            } else if (mode === 'atoms') {
                statusText.innerText = "Biokimyo va Hujayra Diagnostikasi";
                btnAtoms.classList.replace('border-slate-800', 'border-sky-500/50');
            }
        }

        // ==========================================
        // ANIMATION LOOP & RESIZE HANDLING
        // ==========================================
        function animate() {
            requestAnimationFrame(animate);

            // Rotate Hero DNA
            if (dnaGroup) {
                dnaGroup.rotation.y += 0.005;
            }
            if (particlesMesh) {
                particlesMesh.rotation.y -= 0.0008;
            }

            // Rotate Interactive Visualizer Object
            if (currentVisMesh) {
                currentVisMesh.rotation.y += 0.01;
                currentVisMesh.rotation.x += 0.003;
            }

            if (heroRenderer && heroScene && heroCamera) {
                heroRenderer.render(heroScene, heroCamera);
            }
            if (visRenderer && visScene && visCamera) {
                visRenderer.render(visScene, visCamera);
            }
        }

        window.addEventListener('resize', () => {
            // Resize Hero Canvas
            const heroContainer = document.getElementById('hero-3d-container');
            if (heroContainer && heroCamera && heroRenderer) {
                const w = heroContainer.clientWidth;
                const h = heroContainer.clientHeight;
                heroCamera.aspect = w / h;
                heroCamera.updateProjectionMatrix();
                heroRenderer.setSize(w, h);
            }

            // Resize Visualizer Canvas
            const visContainer = document.getElementById('interactive-visualizer-canvas');
            if (visContainer && visCamera && visRenderer) {
                const w = visContainer.clientWidth;
                const h = visContainer.clientHeight;
                visCamera.aspect = w / h;
                visCamera.updateProjectionMatrix();
                visRenderer.setSize(w, h);
            }
        });

        // Start 3D scenes on load
        window.onload = function() {
            initHero3D();
            initVisualizer3D();
            animate();
        };
    </script>
</body>
</html>